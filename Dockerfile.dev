# Fluxio persistent development runtime.
# node and pnpm are pinned explicitly: nixpacks forces pnpm 9, which is too old for
# supportedArchitectures (needed for rolldown/vite native Linux binaries when the
# lockfile was generated on Windows).
FROM node:22-bookworm-slim

WORKDIR /app

# openssh-client provides ssh-keyscan, used by the sync agent. Without it the
# container exits with code 127 and no log output.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g pnpm@11.0.9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

# The entrypoint starts the git sync loop, then hands over to Vite.
COPY fluxio-entrypoint.sh /usr/local/bin/fluxio-entrypoint.sh
RUN chmod +x /usr/local/bin/fluxio-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/fluxio-entrypoint.sh"]
